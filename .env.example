# ─────────────────────────────────────────────────────────────
# GrowthPilot AI — environment configuration
#
# NOTE: The app runs fully in DEMO MODE with NONE of these set.
# Add keys only to enable live Claude generation + Supabase
# persistence. Leaving them blank is a supported, first-class mode.
# ─────────────────────────────────────────────────────────────

# --- Claude (AI layer) ---
# Get one at https://console.anthropic.com/. Without it the app
# serves high-quality deterministic mock responses so demos never
# break on a flaky network or a rate limit.
ANTHROPIC_API_KEY=

# Model id used by every agent. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Supabase (auth + database + storage) ---
# Without these, the workspace keeps data in the browser (localStorage)
# so the whole product is explorable with zero backend setup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for privileged writes (never expose to the client).
SUPABASE_SERVICE_ROLE_KEY=
