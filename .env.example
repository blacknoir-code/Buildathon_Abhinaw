# ─────────────────────────────────────────────────────────────
# GrowthPilot AI — environment configuration
#
# NOTE: The app runs fully in DEMO MODE with NONE of these set.
# Add keys only to enable live generation + Supabase persistence.
# Leaving them blank is a supported, first-class mode.
#
# The AI layer auto-detects the provider: if OPENAI_API_KEY is set it
# uses the OpenAI-compatible gateway; else if ANTHROPIC_API_KEY is set
# it uses Claude; else it serves deterministic demo responses.
# ─────────────────────────────────────────────────────────────

# --- Option A: OpenAI-compatible gateway (e.g. hackathon GPT gateway) ---
# The endpoint must speak the OpenAI Chat Completions API.
OPENAI_API_KEY=
# Base URL WITHOUT the trailing /chat/completions. Defaults to the
# buildathon Bifrost gateway if left blank.
OPENAI_BASE_URL=https://gateway-buildathon.ltl.sh/v1
# Model id served by the gateway (e.g. gpt-4o, gpt-5.5). gpt-4o is
# multimodal and required for Creative Studio image analysis.
OPENAI_MODEL=gpt-4o

# --- Option B: Claude (Anthropic) ---
# Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Supabase (auth + database + storage) — optional ---
# Without these, the workspace keeps data in the browser (localStorage)
# so the whole product is explorable with zero backend setup.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
